{
  "info": {
    "name": "to-markdown 单文件转换联调",
    "description": "验证纯文件转换服务接收 multipart 文件并返回 Markdown 文件。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081"
    }
  ],
  "item": [
    {
      "name": "健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "oMLX 连通性检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/omlx",
          "host": ["{{baseUrl}}"],
          "path": ["health", "omlx"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('oMLX endpoint reachable', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "单文件转换",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "tests/test_files/input/test_pdf.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/convert",
          "host": ["{{baseUrl}}"],
          "path": ["convert"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('返回 Markdown 文件', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/markdown');",
              "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('.md');",
              "    pm.expect(pm.response.text()).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
